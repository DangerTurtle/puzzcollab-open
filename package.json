    "js-yaml": "^5.4.1",
    "kysely": "^0.29.3",
    "mdast-util-find-and-replace": "^3.0.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
