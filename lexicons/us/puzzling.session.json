{
  "lexicon": 1,
  "id": "us.puzzling.session",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A team's attempt at a specific puzzle.",
      "record": {
        "type": "object",
        "required": ["team", "puzzle", "createdAt"],
        "properties": {
          "team": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "puzzle": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "creatorDid": {
            "type": "string",
            "format": "did",
            "description": "The member who started this session."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
