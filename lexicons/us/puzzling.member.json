{
  "lexicon": 1,
  "id": "us.puzzling.member",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "A roster entry granting someone membership on a team.",
      "record": {
        "type": "object",
        "required": ["team", "memberDid", "addedAt"],
        "properties": {
          "team": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          },
          "memberDid": {
            "type": "string",
            "format": "did"
          },
          "addedAt": {
            "type": "string",
            "format": "datetime"
          },
          "invitedBy": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "The invite record redeemed to add this member, if any."
          }
        }
      }
    }
  }
}
